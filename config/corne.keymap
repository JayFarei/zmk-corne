/* Port of JayFarei's saved QMK VIA layout. Physical order: left to right.
 * RGB controls are inactive pending verification of LED hardware.
 * Lower+Z holds the wireless settings layer.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
};

// QMK Grave Escape keeps held Shift/GUI modifiers (Shift+Escape = tilde).
&gresc {
    keep-mods = <(MOD_LGUI | MOD_LSFT | MOD_RGUI | MOD_RSFT)>;
};

/ {
    macros {
        via_m0: via_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LG(LC(LS(G)))>;
        };
        via_m1: via_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(TAB)>;
        };
        via_m2: via_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LG(LBKT)>;
        };
        via_m3: via_macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LG(RBKT)>;
        };
        via_m6: via_macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LC(N1)>;
        };
        via_m7: via_macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LC(N2)>;
        };
        via_m8: via_macro_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LC(N3)>;
        };
        via_m9: via_macro_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LC(N4)>;
        };
        via_m10: via_macro_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LC(N5)>;
        };
        via_m11: via_macro_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp HASH>;
        };
        via_m12: via_macro_12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LG(LA(LS(N9)))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &gresc
                &kp LCTRL  &mt LGUI A  &mt LALT S  &mt LSHFT D  &mt LCTRL F  &kp G  &kp H  &mt RCTRL J  &mt RSHFT K  &mt LALT L  &mt RGUI SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &via_m0
                &kp LGUI  &mo 1  &kp RET  &kp BSPC  &lt 2 SPACE  &kp LS(LALT)
            >;
        };
        lower_layer {
            bindings = <
                &via_m1  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &via_m3
                &kp LALT  &via_m6  &via_m7  &via_m8  &via_m9  &via_m10  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &via_m2
                &kp LSHFT  &mo 3  &none  &none  &none  &none  &kp C_PLAY_PAUSE  &kp C_PREV  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE
                &kp LGUI  &mo 1  &kp RET  &kp BSPC  &none  &trans
            >;
        };
        symbols_layer {
            bindings = <
                &none  &kp LS(N1)  &kp LS(N2)  &via_m11  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &via_m12
                &kp LCTRL  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
                &kp LSHFT  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp LS(MINUS)  &kp LS(EQUAL)  &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(BSLH)  &kp LS(GRAVE)
                &kp LGUI  &trans  &kp RET  &kp BSPC  &kp SPACE  &via_m6
            >;
        };
        wireless_layer {
            bindings = <
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &none
                &none  &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &bt BT_PRV  &bt BT_NXT  &none  &none  &none  &none  &none  &none
                &none  &trans  &none  &none  &none  &bootloader  &none  &none  &none  &none  &none  &none
                &kp LGUI  &trans  &kp RET  &kp BSPC  &kp SPACE  &kp LS(LALT)
            >;
        };
    };
};
